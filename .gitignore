# Only publish LadderMan project files; keep unrelated local work private.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/LadderMan_expert_stage_checklist.md
!/LadderMan_expert_stage_reproduction_guide.md
!/Ladder/
!/assets/
!/docs/
!/scripts/
!/tools/
!/logs/
!/outputs/
!/training_artifacts/

# Credentials, local tools and caches are never part of this snapshot.
**/.git/
**/.aws/
**/.codex/
**/.agents/
**/.ssh/
**/.venv/
**/venv/
**/__pycache__/
**/.pytest_cache/
**/*.egg-info/
*.py[cod]
.env
.env.*
!.env.example
auth.json
credentials.json
*.pem
*.key
*.swp
*.tmp
*.restoring
.DS_Store

# Model allowlist follows below; raw diagnostic tensors/exports stay local.
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors

# Full logs are stored losslessly under training_artifacts/ and can be restored.
/logs/**/events.out.tfevents.*
/logs/**/*.jsonl
/logs/**/*.log

# Publish structured diagnostics, not bulk image/depth dumps or trace tensors.
/outputs/**/*
!/outputs/**/
!/outputs/**/*.json
!/outputs/**/*.csv
!/outputs/**/*.yaml
!/outputs/**/*.yml
!/outputs/**/*.txt
!/outputs/**/*.md
!/outputs/**/*.py
!/outputs/**/*.npz
!/outputs/**/*.tar.gz
/outputs/**/events.out.tfevents.*
/outputs/**/*.jsonl
/outputs/**/*.log

